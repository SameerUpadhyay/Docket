                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "web"
              }
            }
          },
          {
            "Name": "clamav",
            "Image": {
              "Ref": "ClamavImageUri"
            },
            "Essential": true,
            "MemoryReservation": 3072,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "scanner"
              }
            }
          },
          {
            "Name": "init-storage",
