            "MountPoints": [
              {
                "SourceVolume": "temporary",
                "ContainerPath": "/work"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "init"
              }
            },
