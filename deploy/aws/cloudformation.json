                  "Ref": "SenderEmail"
                }
              },
              {
                "Name": "SUPPORT_EMAIL",
                "Value": {
                  "Ref": "SupportEmail"
                }
              },
              {
                "Name": "SES_CONFIGURATION_SET",
                "Value": {
                  "Ref": "MailConfiguration"
                }
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "OBJECT_BUCKET",
                "Value": {
                  "Ref": "Files"
                }
              },
              {
                "Name": "OBJECT_KMS_KEY_ID",
                "Value": {
                  "Fn::GetAtt": [
                    "StorageKey",
                    "Arn"
                  ]
                }
              },
              {
                "Name": "CLAMAV_HOST",
                "Value": "127.0.0.1"
              },
              {
                "Name": "METRICS_NAMESPACE",
                "Value": "Docket/Pilot"
              },
              {
                "Name": "OCR_PROVIDER",
                "Value": "gemini"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Ref": "ApplicationDbSecret"
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "DATA_ENCRYPTION_SECRET",
                "ValueFrom": {
                  "Ref": "DataSecret"
                }
              },
              {
                "Fn::If": [
                  "HasGeminiSecret",
                  {
                    "Name": "GEMINI_API_KEY",
                    "ValueFrom": {
                      "Ref": "GeminiSecretArn"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            },
            "ReadonlyRootFilesystem": true,
            "MountPoints": [
              {
                "SourceVolume": "temporary",
                "ContainerPath": "/tmp"
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "init-storage",
                "Condition": "SUCCESS"
              }
            ]
          },
          {
            "Name": "worker",
            "Image": {
              "Ref": "ApiImageUri"
            },
            "Command": [
              "python",
              "-m",
              "app.workers.delivery"
            ],
            "Essential": true,
            "Environment": [
              {
                "Name": "DOCKET_ENV",
                "Value": "production"
              },
              {
                "Name": "DOCKET_DEMO_MODE",
                "Value": "0"
              },
              {
                "Name": "PUBLIC_URL",
                "Value": {
                  "Fn::Sub": "https://${DomainName}"
                }
              },
              {
                "Name": "ALLOWED_ORIGINS",
                "Value": {
                  "Fn::Sub": "https://${DomainName}"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_USER",
                "Value": "docket_app"
              },
              {
                "Name": "DB_NAME",
                "Value": "docket"
              },
              {
                "Name": "MAIL_TRANSPORT",
                "Value": "ses"
              },
              {
                "Name": "MAIL_FROM",
                "Value": {
                  "Ref": "SenderEmail"
                }
              },
              {
                "Name": "SUPPORT_EMAIL",
                "Value": {
                  "Ref": "SupportEmail"
                }
              },
              {
                "Name": "SES_CONFIGURATION_SET",
                "Value": {
                  "Ref": "MailConfiguration"
                }
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "OBJECT_BUCKET",
                "Value": {
                  "Ref": "Files"
                }
              },
              {
                "Name": "OBJECT_KMS_KEY_ID",
                "Value": {
                  "Fn::GetAtt": [
                    "StorageKey",
                    "Arn"
                  ]
                }
              },
              {
                "Name": "CLAMAV_HOST",
                "Value": "127.0.0.1"
              },
              {
                "Name": "METRICS_NAMESPACE",
                "Value": "Docket/Pilot"
              },
              {
                "Name": "OCR_PROVIDER",
                "Value": "gemini"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Ref": "ApplicationDbSecret"
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "DATA_ENCRYPTION_SECRET",
                "ValueFrom": {
                  "Ref": "DataSecret"
                }
              },
              {
                "Fn::If": [
                  "HasGeminiSecret",
                  {
                    "Name": "GEMINI_API_KEY",
                    "ValueFrom": {
                      "Ref": "GeminiSecretArn"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            },
            "ReadonlyRootFilesystem": true
          },
          {
            "Name": "web",
            "Image": {
              "Ref": "WebImageUri"
            },
            "Essential": true,
            "PortMappings": [
