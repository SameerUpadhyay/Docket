# Template only. Never commit completed secrets or paste them into chat.
DOCKET_ENV=production
DOCKET_DEMO_MODE=0
DOCKET_DOMAIN=docket.example.in
PUBLIC_URL=https://docket.example.in
ALLOWED_ORIGINS=https://docket.example.in
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode password characters; keep consistent with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://docket:REPLACE_WITH_RANDOM_PASSWORD@db:5432/docket
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.in
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=Docket <notices@example.in>
SUPPORT_EMAIL=support@example.in
CLAMAV_HOST=clamav
# Optional private S3 storage. Without it encrypted attachments use PostgreSQL.
# OBJECT_BUCKET=your-private-bucket
# AWS_REGION=ap-south-1
# Supply workload IAM credentials through the hosting platform, not this file.
# OBJECT_KMS_KEY_ID=your-kms-key-id
# S3_ENDPOINT_URL=optional-S3-compatible-endpoint
# Optional cloud OCR and summaries; separate owner consents are required.
# Use the hosting secret manager for GEMINI_API_KEY, never source or chat.
# OCR_PROVIDER=local is the default. gemini sends original scanned page images;
# textract is English-only. Confirm model access and evaluate before enabling.
OCR_PROVIDER=local
# GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Docker installs checksum-locked English/Hindi models under /service/models.
OCR_MAX_CONCURRENT_DOCS=1
