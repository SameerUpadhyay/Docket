# Optional: only redacted text is sent for English/Hindi summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DATABASE_PATH defaults to app/data/docket.sqlite3.

# Originals are only sent to a cloud OCR provider after separate owner consent.
OCR_PROVIDER=local
GEMINI_OCR_MODEL=gemini-2.5-flash
OCR_MAX_CONCURRENT_DOCS=1
# TESSERACT_CMD=/path/to/tesseract
# TESSDATA_PREFIX=/path/to/locked/eng-and-hin-models

# Selective email forwarding (no inbox OAuth). Leave unset for local previews.
# Set these only after your receiving provider and DNS are configured.
# INBOUND_EMAIL_DOMAIN=inbound.your-domain.example
# Or use Postmark's existing inbound address for sub-address routing:
# INBOUND_POSTMARK_ADDRESS=yourserverhash@inbound.postmarkapp.com
# INBOUND_EMAIL_PROVIDER=postmark
# INBOUND_POSTMARK_USER=docket-inbound
# INBOUND_POSTMARK_PASSWORD=<generate-at-least-32-random-characters>
# For a trusted HMAC-signing SMTP/provider adapter instead:
# INBOUND_EMAIL_PROVIDER=hmac
# INBOUND_WEBHOOK_SECRET=<generate-at-least-32-random-characters>
# INBOUND_TRUSTED_ARC_SEALERS=google.com
# Development starts an inline recovery worker; production uses email-worker.
# INBOUND_INLINE_WORKER=1

# Dedicated hosted inbox: no work email, custom domain or public webhook needed.
# Store the real key only in the server environment or ignored .secrets/inbound.env.
# INBOUND_EMAIL_PROVIDER=agentmail
# INBOUND_AGENTMAIL_ADDRESS=your-dedicated-inbox@agentmail.to
# AGENTMAIL_API_KEY=<inbox-scoped-read-only-key>
# AGENTMAIL_INBOX_ID=<optional-provider-id-if-different-from-email>
